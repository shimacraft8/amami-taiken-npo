{
  "$schema": "node_modules/wrangler/config-schema.json",
  // SHIMA CRAFT の Cloudflare アカウント（shimacraft8@gmail.com）に固定。別アカウントへは配信されない。
  "account_id": "42f69e35f08bb21dca5194467e2f59de",
  "name": "amami-taiken-npo",
  "main": "worker.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    // 動画だけはWorkerを先に通し、Range(206)応答を返す（worker.ts）
    "run_worker_first": ["/*.mp4"]
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "amami-taiken-npo" }],
  "workers_dev": true,
  "vars": { "CF_ENV": "preview" },
  "env": {
    "production": {
      "name": "amami-taiken-npo-production",
      "workers_dev": false,
      // DNSの A レコード（apex / www）をプロキシ(オレンジ)にすると、このルートで Worker が応答する。
      // 灰色に戻せば旧Vercelへ即時に戻る（ロールバック手段）。
      "routes": [
        { "pattern": "amamitaiken.com/*", "zone_name": "amamitaiken.com" },
        { "pattern": "www.amamitaiken.com/*", "zone_name": "amamitaiken.com" }
      ],
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "amami-taiken-npo-production" }],
      "vars": { "CF_ENV": "production" }
    }
  }
}
